# ==============================================================================
# SAGE Productivity Platform — Environment Variables Example
# ==============================================================================
# Copy this file to .env or set these in your local environment.
# NEVER commit real secret values to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (auth-service)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/authdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 2. JWT Security (api-gateway & auth-service)
# ------------------------------------------------------------------------------
JWT_SECRET=sage-secret-key-super-secure-at-least-32-bytes-long

# ------------------------------------------------------------------------------
# 3. Google OAuth & Identity (auth-service & frontend)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Ask SAGE: AI Assistant Provider (Google Gemini)
# ------------------------------------------------------------------------------
# Backend-only! Never expose with VITE_ prefix.
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------------------
# 5. Email Reminders Provider (Resend)
# ------------------------------------------------------------------------------
# Backend-only! Never expose with VITE_ prefix.
# Obtain API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=SAGE <onboarding@resend.dev>

# Background Scheduled Reminder Worker
REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 6. Service Discovery & Ports
# ------------------------------------------------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka
VITE_API_BASE_URL=/api
